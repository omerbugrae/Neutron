{
  "name": "neutron",
  "productName": "Neutron",
  "version": "0.1.0",
  "private": true,
  "description": "Neutron desktop security application",
  "main": "src/main.cjs",
  "scripts": {
    "postinstall": "patch-package",
    "prestart": "npm run icon:build && npm run archive:check",
    "start": "electron .",
    "prepackage": "npm run icon:build && npm run archive:check && npm run engine:build && npm run engine:verify && npm run amsi:build && npm run amsi:verify && npm run service:build && npm run service:verify",
    "package": "electron-forge package",
    "premake": "npm run icon:build && npm run archive:check && npm run engine:build && npm run engine:verify && npm run amsi:build && npm run amsi:verify && npm run service:build && npm run service:verify",
    "make": "electron-forge make",
    "make:win:x64": "electron-forge make --platform=win32 --arch=x64",
    "make:win:ia32": "electron-forge make --platform=win32 --arch=ia32",
    "setup:test": "node tools/build-test-setup.cjs",
    "make:proton": "node tools/proton/make-with-runtime-key.cjs",
    "icon:build": "electron tools/build-windows-icon.cjs",
    "archive:check": "node --check src/neutron-archive.cjs",
    "archive:version": "node src/neutron-archive.cjs --version",
    "engine:build": ".\\venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean --distpath runtime\\engine\\x64 --workpath build\\pyinstaller tools\\engine\\neutron-engine.spec",
    "engine:verify": "node tools/engine/verify-engine.cjs x64",
    "engine:version": ".\\runtime\\engine\\x64\\neutron-engine\\neutron-engine.exe --engine-version --json-lines",
    "amsi:build": "powershell -ExecutionPolicy Bypass -File tools\\amsi\\build.ps1 x64",
    "amsi:verify": "node tools/amsi/verify-amsi.cjs x64",
    "service:build": "powershell -ExecutionPolicy Bypass -File tools\\service\\build.ps1 x64",
    "service:verify": "node tools/service/verify-service.cjs x64",
    "proton:keygen": "node tools/proton/keygen.cjs",
    "proton:pack": "node tools/proton/pack.cjs",
    "proton:verify": "node tools/proton/verify.cjs",
    "proton:test": "node tools/proton/self-test.cjs",
    "proton:update-test": "node tools/proton/updater-self-test.cjs",
    "proton:publish": "node tools/proton/publish.cjs",
    "proton:publish-test": "node tools/proton/publish-self-test.cjs",
    "proton:collect": "node tools/proton/collect-abusech.cjs",
    "proton:collect-test": "node tools/proton/collect-self-test.cjs",
    "proton:sync": "node tools/proton/collect-and-publish.cjs",
    "license:keygen": "node tools/license/keygen.cjs",
    "license:issue": "node tools/license/issue.cjs",
    "license:test": "node tools/license/self-test.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "electron": "^43.3.0",
    "patch-package": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omerbugrae/Neutron.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/omerbugrae/Neutron/issues"
  },
  "homepage": "https://github.com/omerbugrae/Neutron#readme",
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": false,
        "extraResource": [
          "runtime"
        ],
        "ignore": [
          "^/venv($|/)",
          "^/build($|/)",
          "^/runtime($|/)",
          "^/tests($|/)",
          "^/tools($|/)",
          "^/data/neutron\\.db$"
        ],
        "executableName": "Neutron",
        "icon": "assets/neutron",
        "win32metadata": {
          "CompanyName": "Neutron",
          "FileDescription": "Neutron Security",
          "ProductName": "Neutron",
          "InternalName": "Neutron",
          "OriginalFilename": "Neutron.exe"
        }
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "neutron",
            "authors": "Neutron",
            "description": "Neutron desktop security application",
            "setupIcon": "assets/neutron.ico",
            "iconUrl": "https://raw.githubusercontent.com/omerbugrae/Neutron/main/assets/neutron.ico"
          }
        }
      ],
      "publishers": [
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "omerbugrae",
              "name": "Neutron"
            },
            "prerelease": false
          }
        }
      ]
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
